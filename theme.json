{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "viewport": {
      "mobile": "480px",
      "tablet": "782px"
    },
    "layout": {
      "contentSize": "1560px",
      "wideSize": "1600px"
    },
    "background": {
      "backgroundImage": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "link": true,
      "palette": [
        {
          "slug": "primary",
          "color": "#FF0000",
          "name": "Principale"
        },
        {
          "slug": "secondary",
          "color": "#00FF00",
          "name": "Secondaire"
        },
        {
          "slug": "accent",
          "color": "#0000FF",
          "name": "Accent"
        },
        {
          "slug": "text",
          "color": "#1A1A1A",
          "name": "Texte"
        },
        {
          "slug": "background",
          "color": "#FFFFFF",
          "name": "Fond"
        },
        {
          "slug": "light",
          "color": "#F4F4F1",
          "name": "Clair"
        },
        {
          "slug": "dark",
          "color": "#111827",
          "name": "Foncé"
        }
      ]
    },
    "custom": {
      "typography": {
        "font-size": {},
        "line-height": {}
      }
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": [
        "px",
        "%",
        "em",
        "rem",
        "vw",
        "vh"
      ],
      "defaultSpacingSizes": false,
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "20", "size": "clamp(0.26rem, 0.2rem + 0.33vw, 0.44rem)", "name": "2XS" },
        { "slug": "30", "size": "clamp(0.4rem, 0.3rem + 0.5vw, 0.67rem)", "name": "XS" },
        { "slug": "40", "size": "clamp(0.6rem, 0.45rem + 0.74vw, 1rem)", "name": "S" },
        { "slug": "50", "size": "clamp(0.9rem, 0.68rem + 1.11vw, 1.5rem)", "name": "M" },
        { "slug": "60", "size": "clamp(1.35rem, 1.02rem + 1.67vw, 2.25rem)", "name": "L" },
        { "slug": "70", "size": "clamp(2.43rem, 1.74rem + 2.5vw, 3.88rem)", "name": "XL" },
        { "slug": "80", "size": "clamp(3.44rem, 2.9rem + 3.75vw, 7.06rem)", "name": "2XL" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": false,
      "lineHeight": true,
      "fluid": false,
      "fontFamilies": [
        {
          "name": "Titres",
          "slug": "heading",
          "fontFamily": "'Instrument Serif', serif",
          "fontFace": [
            { "fontFamily": "Instrument Serif", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./resources/fonts/instrument-serif-v5-latin-regular.woff2"] },
            { "fontFamily": "Instrument Serif", "fontWeight": "400", "fontStyle": "italic", "fontDisplay": "swap", "src": ["file:./resources/fonts/instrument-serif-v5-latin-italic.woff2"] }
          ]
        },
        {
          "name": "Texte",
          "slug": "body",
          "fontFamily": "'Inter', sans-serif",
          "fontFace": [
            { "fontFamily": "Inter", "fontWeight": "200", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./resources/fonts/inter-v20-latin-200.woff2"] },
            { "fontFamily": "Inter", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./resources/fonts/inter-v20-latin-regular.woff2"] },
            { "fontFamily": "Inter", "fontWeight": "400", "fontStyle": "italic", "fontDisplay": "swap", "src": ["file:./resources/fonts/inter-v20-latin-italic.woff2"] },
            { "fontFamily": "Inter", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./resources/fonts/inter-v20-latin-600.woff2"] },
            { "fontFamily": "Inter", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./resources/fonts/inter-v20-latin-700.woff2"] },
            { "fontFamily": "Inter", "fontWeight": "700", "fontStyle": "italic", "fontDisplay": "swap", "src": ["file:./resources/fonts/inter-v20-latin-700italic.woff2"] },
            { "fontFamily": "Inter", "fontWeight": "900", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./resources/fonts/inter-v20-latin-900.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        {
          "name": "Extra Extra Small",
          "slug": "xx-small",
          "size": "10px",
          "fluid": false
        },
        {
          "name": "Extra Small",
          "slug": "x-small",
          "size": "14px",
          "fluid": false
        },
        {
          "name": "Small",
          "slug": "small",
          "size": "16px",
          "fluid": false
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "18px",
          "fluid": false
        },
        {
          "name": "Medium-Large",
          "slug": "medium-large",
          "size": "22px",
          "fluid": false
        },
        {
          "name": "Medium-Extra-Large",
          "slug": "medium-x-large",
          "size": "26px",
          "fluid": false
        },
        {
          "name": "Medium-Extra-Extra-Large",
          "slug": "medium-xx-large",
          "size": "30px",
          "fluid": false
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "36px",
          "fluid": {
            "min": "24px",
            "max": "36px"
          }
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "48px",
          "fluid": {
            "min": "32px",
            "max": "48px"
          }
        },
        {
          "name": "Extra Extra Large",
          "slug": "xx-large",
          "size": "56px",
          "fluid": {
            "min": "32px",
            "max": "56px"
          }
        }
      ]
    },
    "blocks": {
      "core/group": {
        "background": {
          "backgroundImage": true,
          "backgroundSize": true
        }
      }
    }
  },
  "styles": {
    "color": {
      "text": "var(--wp--preset--color--text)",
      "background": "var(--wp--preset--color--background)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--small)"
    },
    "spacing": {
      "blockGap": "2rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)"
        }
      }
    }
  }
}
