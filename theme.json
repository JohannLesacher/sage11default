{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "layout": {
      "contentSize": "1150px",
      "wideSize": "1250px"
    },
    "background": {
      "backgroundImage": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "custom": true,
      "customGradient": true,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "link": true,
      "palette": [
        {
          "slug": "beige-0",
          "color": "#EDDDC4",
          "name": "Beige"
        },
        {
          "slug": "burgondy-0",
          "color": "#971436",
          "name": "Burgondy"
        },
        {
          "slug": "light-blue",
          "color": "#A9CDD2",
          "name": "Light Blue"
        },
        {
          "slug": "blue-0",
          "color": "#65888D",
          "name": "Blue"
        },
        {
          "slug": "blue-1",
          "color": "#587579",
          "name": "Blue 1"
        },
        {
          "slug": "blue-2",
          "color": "#516d71",
          "name": "Blue 2"
        },
        {
          "slug": "blue-3",
          "color": "#3d5255",
          "name": "Blue 3"
        },
        {
          "slug": "black",
          "color": "#000000",
          "name": "Black"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        }
      ]
    },
    "custom": {
      "typography": {
        "font-size": {},
        "line-height": {}
      }
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": [
        "px",
        "%",
        "em",
        "rem",
        "vw",
        "vh"
      ],
      "defaultSpacingSizes": false,
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "20", "size": "clamp(0.375rem, 0.32rem + 0.24vw, 0.5rem)", "name": "2XS" },
        { "slug": "30", "size": "clamp(0.625rem, 0.5rem + 0.54vw, 0.875rem)", "name": "XS" },
        { "slug": "40", "size": "clamp(0.9rem, 0.71rem + 0.85vw, 1.375rem)", "name": "S" },
        { "slug": "50", "size": "clamp(1.25rem, 0.97rem + 1.22vw, 1.875rem)", "name": "M" },
        { "slug": "60", "size": "clamp(2.275rem, 1.87rem + 1.79vw, 3.75rem)", "name": "L" },
        { "slug": "70", "size": "clamp(2.6rem, 2.04rem + 2.5vw, 5rem)", "name": "XL" },
        { "slug": "80", "size": "clamp(2.925rem, 2.3rem + 2.77vw, 6.25rem)", "name": "2XL" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "lineHeight": true,
      "fluid": false,
      "fontFamilies": [
        {
          "name": "Hanken Grotesk",
          "slug": "hanken-grotesk",
          "fontFamily": "Hanken Grotesk, sans-serif"
        },
        {
          "name": "EB Garamond",
          "slug": "eb-garamond",
          "fontFamily": "EB Garamond, serif"
        }
      ],
      "fontSizes": [
        {
          "name": "Extra Small",
          "slug": "x-small",
          "size": "12px",
          "fluid": false
        },
        {
          "name": "Small",
          "slug": "small",
          "size": "16px",
          "fluid": false
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "18px",
          "fluid": false
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "32px",
          "fluid": {
            "min": "24px",
            "max": "32px"
          }
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "40px",
          "fluid": {
            "min": "28px",
            "max": "40px"
          }
        },
        {
          "name": "Extra Extra Large",
          "slug": "xx-large",
          "size": "72px",
          "fluid": {
            "min": "44px",
            "max": "72px"
          }
        }
      ]
    },
    "blocks": {
      "core/group": {
        "background": {
          "backgroundImage": true,
          "backgroundSize": true
        }
      }
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "'Inter', sans-serif",
      "fontSize": "16px"
    },
    "spacing": {
      "blockGap": "2rem"
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": {
            "topLeft": "0",
            "topRight": "0",
            "bottomLeft": "0",
            "bottomRight": "0"
          }
        }
      }
    }
  }
}
