{
  "name": "johannlesacher/sage11default",
  "type": "wordpress-theme",
  "license": "MIT",
  "description": "Thème de base WordPress : Sage 11, Acorn, MB Blocks.",
  "authors": [
    {
      "name": "Johann Lesacher",
      "email": "lesacher.johann@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "require": {
    "php": ">=8.3",
    "blade-ui-kit/blade-icons": "^1.9",
    "enshrined/svg-sanitize": "^1.1",
    "johnbillion/extended-cpts": "^5.1",
    "log1x/navi": "^3.1",
    "roots/acorn": "^6.0"
  },
  "require-dev": {
    "carthage-software/mago": "^1.0"
  },
  "suggest": {
    "log1x/sage-directives": "A collection of useful Blade directives for WordPress and Sage (^1.0)."
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "format": "mago format --check",
    "format:fix": "mago format",
    "lint": "mago lint",
    "post-autoload-dump": [
      "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
    ]
  }
}
